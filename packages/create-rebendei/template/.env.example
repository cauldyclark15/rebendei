# Postgres 17 with pgvector. Matches docker-compose.yml.
DATABASE_URL=postgres://rebendei:rebendei@localhost:54329/rebendei
# HTTP and WebSocket server port.
PORT=3210
# Optional client demo URL override; otherwise it uses localhost and PORT.
# REBENDEI_URL=http://localhost:3210

# Free local embeddings: install Ollama, then ollama pull nomic-embed-text.
# Base URL must include /v1. Embedding and chat models are separate.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
# Must match the model's output, 1 through 2000 for pgvector HNSW.
EMBEDDING_DIMENSIONS=768
# Optional, server-only. Ollama needs no key.
# EMBEDDING_API_KEY=your-server-side-key

# Chat is optional. Enable knowledge:ask by setting CHAT_MODEL.
# For free local chat: ollama pull llama3.2, then uncomment these lines.
# CHAT_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=llama3.2
# Optional, server-only. Ollama needs no key.
# CHAT_API_KEY=your-server-side-key

# Hosted OpenAI example: replace the values above, do not keep duplicate keys.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=your-server-side-key
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_API_KEY=your-server-side-key

# OpenRouter example: choose an embedding-capable model and its dimensions.
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=your-embedding-model-id
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=your-server-side-key
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=your-chat-model-id
# CHAT_API_KEY=your-server-side-key
# A namespace fixes its embedding model/dimensions on first ingest. To switch,
# use a new namespace in rebendei/knowledge.js and re-ingest your documents.
