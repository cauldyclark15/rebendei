  "engines": { "bun": ">=1.3.0" },
  "repository": { "type": "git", "url": "git+https://github.com/cauldyclark15/rebendei.git", "directory": "packages/rebendei" },
  "keywords": ["bun", "postgres", "pgvector", "realtime", "reactive", "backend"]
